# Ignore generated dataset contents
generated_dataset/audio/*
generated_dataset/truth/*
generated_dataset/predictions/*
generated_dataset/normalized_sources/*

# Allow Git to look inside generated_dataset folders
!generated_dataset/
!generated_dataset/**/

# Keep metrics.json files inside generated_dataset
!generated_dataset/**/metrics.json
